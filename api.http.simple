@baseUrl = http://localhost:3000
@access_token =

### ==================== AUTH ====================

### Register Admin
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123",
  "firstName": "Admin",
  "lastName": "User"
}

### Login Admin
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123"
}

### Login IT Support
# @name loginIT
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "it@example.com",
  "password": "password123"
}

### Login Employee
# @name loginEmployee
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "employee@example.com",
  "password": "password123"
}

### ==================== CATEGORIES ====================

### Create Category (Admin/IT)
POST {{baseUrl}}/api/categories
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "name": "Hardware",
  "description": "ปัญหาเกี่ยวกับฮาร์ดแวร์ เช่น คอมพิวเตอร์ จอภาพ คีย์บอร์ด เมาส์"
}

### Create Another Category
POST {{baseUrl}}/api/categories
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "name": "Software",
  "description": "ปัญหาเกี่ยวกับซอฟต์แวร์ ระบบปฏิบัติการ แอปพลิเคชัน"
}

### Create Network Category
POST {{baseUrl}}/api/categories
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "name": "Network",
  "description": "ปัญหาเกี่ยวกับเครือข่าย อินเทอร์เน็ต VPN ไวไฟ"
}

### Get All Categories (All roles)
GET {{baseUrl}}/api/categories
Authorization: Bearer {{loginEmployee.response.body.access_token}}

### Get Category by ID
GET {{baseUrl}}/api/categories/{{createCategory.response.body.id}}
Authorization: Bearer {{loginEmployee.response.body.access_token}}

### Update Category (Admin/IT)
PUT {{baseUrl}}/api/categories/{{createCategory.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "name": "Hardware & Peripherals",
  "description": "ปัญหาเกี่ยวกับฮาร์ดแวร์และอุปกรณ์เสริม"
}

### Delete Category (Admin only)
DELETE {{baseUrl}}/api/categories/{{createCategory.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.access_token}}


### ==================== TICKETS ====================

### Create Ticket (Employee)
POST {{baseUrl}}/api/tickets
Content-Type: application/json
Authorization: Bearer {{loginEmployee.response.body.access_token}}

{
  "title": "คอมพิวเตอร์ไม่เปิดเครื่อง",
  "description": "คอมพิวเตอร์ไม่ตอบสนองเมื่อกดปุ่มเปิด ไฟไม่ติดเลย",
  "priority": "HIGH",
  "categoryId": "{{createCategory.response.body.id}}"
}

### Create Another Ticket (IT Support)
POST {{baseUrl}}/api/tickets
Content-Type: application/json
Authorization: Bearer {{loginIT.response.body.access_token}}

{
  "title": "Outlook ไม่สามารถส่งอีเมลได้",
  "description": "คลิกส่งแล้วค้างอยู่ที่ Outbox ไม่มี Error แสดง",
  "priority": "MEDIUM",
  "categoryId": "{{createCategory2.response.body.id}}"
}

### Create Network Ticket
POST {{baseUrl}}/api/tickets
Content-Type: application/json
Authorization: Bearer {{loginEmployee.response.body.access_token}}

{
  "title": "WiFi ตัดขาดบ่อย",
  "description": "WiFi ในห้องประชุมชั้น 3 ตัดขาดบ่อยมาก ใช้งานไม่ได้",
  "priority": "CRITICAL",
  "categoryId": "{{createCategory3.response.body.id}}"
}

### Get All Tickets (Employee - own tickets only)
GET {{baseUrl}}/api/tickets
Authorization: Bearer {{loginEmployee.response.body.access_token}}

### Get All Tickets (Admin - all tickets)
GET {{baseUrl}}/api/tickets
Authorization: Bearer {{loginAdmin.response.body.access_token}}

### Get All Tickets with Filters
GET {{baseUrl}}/api/tickets?status=OPEN&priority=HIGH
Authorization: Bearer {{loginAdmin.response.body.access_token}}

### Get Ticket by ID (Owner)
GET {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}
Authorization: Bearer {{loginEmployee.response.body.access_token}}

### Get Ticket by ID (Admin)
GET {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.access_token}}

### Update Ticket (Employee - own ticket)
PUT {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{loginEmployee.response.body.access_token}}

{
  "title": "คอมพิวเตอร์ไม่เปิดเครื่อง (อัปเดต: เช็คสายไฟแล้ว)",
  "description": "คอมพิวเตอร์ไม่ตอบสนองเมื่อกดปุ่มเปิด ไฟไม่ติดเลย เช็คสายไฟแล้ว ต่อดีอยู่",
  "priority": "CRITICAL"
}

### Update Ticket Status (IT Support - can change status)
PUT {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{loginIT.response.body.access_token}}

{
  "status": "IN_PROGRESS"
}

### Assign Ticket (IT Support)
PUT {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{loginIT.response.body.access_token}}

{
  "assignedToId": "{{loginIT.response.body.user.id}}",
  "status": "IN_PROGRESS"
}

### Resolve Ticket (IT Support)
PUT {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{loginIT.response.body.access_token}}

{
  "status": "RESOLVED"
}

### Close Ticket (Admin)
PUT {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "status": "CLOSED"
}

### Add Comment (Employee - ticket owner)
POST {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}/comments
Content-Type: application/json
Authorization: Bearer {{loginEmployee.response.body.access_token}}

{
  "content": "ขอบคุณทีม IT ที่ช่วยดูแลครับ ปัญหาแก้ไขได้แล้ว"
}

### Add Internal Comment (IT Support)
POST {{baseUrl}}/api/tickets/{{createTicket.response.body.id}}/comments
Content-Type: application/json
Authorization: Bearer {{loginIT.response.body.access_token}}

{
  "content": "เปลี่ยน Power Supply ใหม่แล้ว ทดสอบทำงานปกติ",
  "isInternal": true
}

### Delete Ticket (Owner - Employee)
DELETE {{baseUrl}}/api/tickets/{{createTicket2.response.body.id}}
Authorization: Bearer {{loginEmployee.response.body.access_token}}

### Delete Ticket (Admin)
DELETE {{baseUrl}}/api/tickets/{{createTicket3.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.access_token}}


### ==================== USER PROFILE ====================

### Get My Profile
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{loginEmployee.response.body.access_token}}