# ==========================================
# Database Configuration (PostgreSQL 16)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=servicedesk_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ==========================================
# pgAdmin 4 Configuration
# ==========================================
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@servicedesk.local
PGADMIN_DEFAULT_PASSWORD=adminpassword

# ==========================================
# Application Configuration
# ==========================================
APP_PORT=9091

# ==========================================
# Authentication & JWT
# ==========================================
JWT_SECRET=superSecretKeyForServiceDesk12345
JWT_EXPIRES_IN=7d

# ==========================================
# Default Seed Accounts (for testing)
# ==========================================
ADMIN_EMAIL=admin@servicedesk.local
ADMIN_PASSWORD=Password123!
IT_SUPPORT_EMAIL=support@servicedesk.local
IT_SUPPORT_PASSWORD=Password123!
USER_EMAIL=employee1@servicedesk.local
USER_PASSWORD=Password123!
